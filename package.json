{
  "name": "mkhalaf-warehouse",
  "version": "1.1.0",
  "description": "مخزن م. خلف — Offline warehouse / inventory management",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --x64",
    "dist:installer": "electron-builder --win nsis --x64",
    "test": "node test/smoke.js",
    "test:e2e": "node test/e2e.js",
    "dist:zip": "electron-builder --win zip --x64",
    "dist:mac": "electron-builder --mac dmg zip --universal"
  },
  "author": "M. Khalaf",
  "license": "UNLICENSED",
  "dependencies": {
    "exceljs": "^4.4.0",
    "sql.js": "^1.17.0"
  },
  "devDependencies": {
    "@fontsource/cairo": "^5.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.65.1"
  },
  "productName": "M. Khalaf Warehouse",
  "private": true,
  "build": {
    "appId": "com.mkhalaf.warehouse",
    "productName": "M. Khalaf Warehouse",
    "copyright": "M. Khalaf",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "shared/**",
      "renderer/**",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "artifactName": "MKhalafWarehouse-${version}-win-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "MKhalafWarehouse-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "مخزن م. خلف",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "MKhalafWarehouse-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    },
    "electronLanguages": [
      "ar",
      "en-US"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.business",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "MKhalafWarehouse-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "M. Khalaf Warehouse"
    }
  }
}
